# Peer resolution: install peers automatically but do not hard-fail the install
# on a peer mismatch (the NestJS 11 ecosystem still ships packages with narrower
# peer ranges than they actually require).
auto-install-peers=true
strict-peer-dependencies=false

# Symlink workspace packages instead of fetching them from a registry, so
# `@apple-pay/*` deps resolve to the local source during development.
link-workspace-packages=true

# Deliberately NOT set: shamefully-hoist. Strict (non-hoisted) node_modules
# means a package can only import what it declares in its own package.json, so
# an undeclared dependency fails locally instead of in the pruned Docker image.
