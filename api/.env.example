# ─────────────────────────────────────────────────────────────────────────────
# Copy to api/.env and fill in. Every value marked REPLACE_ME is REFUSED at boot
# by the config schema, so a half-filled copy of this file cannot start the
# service — see api/src/config/validation-schema.ts.
#
# api/.env is gitignored. It holds credentials for a live Apple Developer account
# and a shared database; it belongs in a secret manager, not in a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# local | development | test | staging | sandbox | production
# Anything other than local/development/test enables the shared-tier posture
# guards: an API key, a real CORS allowlist, TLS to MySQL, headless browser.
ENVIRONMENT=local
NODE_ENV=development
PORT=3000
SERVICE_NAME=apple-pay-api

# ── Logging ──────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable output. Defaults on for local/development/test, off elsewhere.
LOG_PRETTY=true

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated exact-match origins. REQUIRED outside local/development/test,
# where `*` is also refused. Leave blank locally to allow any origin.
CORS_ALLOWED_ORIGINS=
# Express `trust proxy`: hop count (1), boolean, CIDR, or preset (loopback).
TRUST_PROXY=1
BODY_LIMIT=256kb

# ── Access control ───────────────────────────────────────────────────────────
# Shared secret for POST/DELETE /api/domain-verifications*, sent as `x-api-key`.
# Minimum 32 characters. REQUIRED outside local/development/test — these routes
# add domains to a live Apple Pay merchant identifier.
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── Docs ─────────────────────────────────────────────────────────────────────
# Swagger at /docs. Defaults on for local/development/test; refused outright
# when ENVIRONMENT=production.
SWAGGER_ENABLED=true

# ── MySQL: phoenix_release.apple_pay_domain_verifications ────────────────────
# This service is a guest in this schema. It never runs a migration and never
# issues a DELETE — see DomainVerificationRepository.
DB_HOST=REPLACE_ME
DB_PORT=3306
DB_NAME=phoenix_release
DB_USER=REPLACE_ME
DB_PASSWORD=REPLACE_ME
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=10000
# TLS to the database. Defaults ON; cannot be disabled outside dev-like tiers.
DB_SSL=true
# CA bundle for the database's certificate chain. REQUIRED when the cluster's CA
# is not in Node's default trust store — the symptom is a HANDSHAKE_SSL_ERROR
# reading "unable to get local issuer certificate". The phoenix-test-cluster
# needs it. There is deliberately no option to skip certificate verification.
#   curl -o api/certs/rds-global-bundle.pem \
#     https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL_CA_PATH=./certs/rds-global-bundle.pem

# ── Apple Developer portal ───────────────────────────────────────────────────
APPLE_ID_EMAIL=REPLACE_ME
APPLE_ID_PASSWORD=REPLACE_ME
# 10-character team identifier from the portal URL.
APPLE_TEAM_ID=REPLACE_ME
# Merchant identifier, e.g. merchant.phoenix.applepay8
APPLE_MERCHANT_ID=REPLACE_ME
APPLE_PORTAL_BASE_URL=https://developer.apple.com

# ── Playwright ───────────────────────────────────────────────────────────────
# The authenticated browser session. Apple ID sign-in is 2FA-gated, so THIS FILE
# — not the password — is what makes an unattended run possible. Create it once
# with `pnpm apple:login`. Treat it as a credential for the whole account.
APPLE_SESSION_STATE_PATH=.playwright/apple-portal-state.json
# Which browser to drive:
#   chromium (default) — Playwright's bundled build, from `playwright install`
#   chrome | msedge    — the branded build already installed on this machine.
#                        Playwright never downloads these.
BROWSER_CHANNEL=chromium
# Set this to drive a PERSISTENT browser profile instead of a throwaway one
# seeded from APPLE_SESSION_STATE_PATH. The profile becomes the credential: log
# in once and it stays logged in, including Apple's "trust this browser" state,
# which a storageState JSON does not carry.
#
# Use a DEDICATED directory. Chrome holds a process-singleton lock on a profile,
# so pointing this at your everyday profile means quitting your browser before
# every run. The directory holds a live Apple session — treat it as a credential.
# BROWSER_USER_DATA_DIR=.playwright/chrome-profile
# Which profile INSIDE that directory to open, e.g. 'Profile 4'. Only needed when
# pointing at a real Chrome installation, which keeps many profiles under one
# user-data-dir and defaults to the one named 'Default'. Find yours at
# chrome://version → "Profile Path".
# BROWSER_PROFILE_DIRECTORY=Profile 4
# Chromium renderer sandbox. Defaults ON (Playwright's own default is OFF, which
# launches Chrome with --no-sandbox and a security warning banner). Set false only
# where the sandbox cannot work — typically a container lacking the required
# kernel capabilities.
# BROWSER_SANDBOX=true

# Headless. Cannot be disabled outside dev-like tiers (no display server there).
PLAYWRIGHT_HEADLESS=true
# Slows every action down, for watching a run debug itself.
PLAYWRIGHT_SLOW_MO_MS=0
PLAYWRIGHT_NAV_TIMEOUT_MS=45000
PLAYWRIGHT_ACTION_TIMEOUT_MS=20000
PLAYWRIGHT_DOWNLOAD_DIR=.artifacts/downloads
# A trace of a failed run is the only record of a DOM we do not control at the
# moment it stopped matching our selectors. Open with: npx playwright show-trace
PLAYWRIGHT_TRACE_DIR=.artifacts/traces
PLAYWRIGHT_TRACE_ON_FAILURE=true

# ── Verification behaviour ───────────────────────────────────────────────────
# Confirm the association file is live on the domain before asking Apple to
# fetch it. Turning this off means a failed Apple check with an error that says
# nothing about the real cause.
DOMAIN_PROBE_ENABLED=true
DOMAIN_PROBE_TIMEOUT_MS=10000
DOMAIN_PROBE_ATTEMPTS=5
DOMAIN_PROBE_DELAY_MS=2000
# Serve /.well-known/apple-developer-merchantid-domain-association from the
# table. Leave false when another service already owns that route for the domain.
WELL_KNOWN_SERVE_ENABLED=false

# ── Renewal cron ─────────────────────────────────────────────────────────────
# Drives the portal once per due domain. Enable on EXACTLY ONE instance — two
# replicas sweeping concurrently race on the same Apple session.
CRON_ENABLED=false
RENEWAL_CRON=0 3 * * *

# ── Boot gate escape hatch ───────────────────────────────────────────────────
# Downgrades config validation from fail-fast to a warning. For unblocking an
# operator mid-incident; refused outside local/development/test.
# CONFIG_VALIDATION_LOG_ONLY=false
